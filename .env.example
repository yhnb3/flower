# Clerk publishable key is intentionally available to the Vite browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only credentials. Never add the VITE_ prefix to these values.
CLERK_SECRET_KEY=sk_test_replace_me
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace_me

# Comma-separated frontend origins accepted by Clerk token verification.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-project.vercel.app

# Comma-separated primary email addresses allowed to use the planner.
ALLOWED_USER_EMAILS=owner@example.com,second-owner@example.com

# Legacy fallback used only when ALLOWED_USER_EMAILS is empty.
OWNER_CLERK_USER_ID=
